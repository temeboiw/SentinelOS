{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "puter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Puter GPT-6 Sol",
      "options": {
        "baseURL": "https://api.puter.com/puterai/openai/v1/",
        "apiKey": "{env:PUTER_TOKEN}"
      },
      "models": {
        "openai/gpt-6-sol": {
          "name": "GPT-6 Sol",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "puter/openai/gpt-6-sol"
}

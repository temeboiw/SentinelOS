#pragma once
#include <stdint.h>
#include "serial.h"
#include "vmm.h"
#include "virtio_blk.h"

/*
 * SentinelOS Intel HD Audio — milestone 1.
 * Detects PCI class 04h / subclass 03h.
 * No controller registers are touched yet.
 */

static int hda_detected;
static uint8_t hda_bus, hda_slot, hda_func;
static uint64_t hda_bar0;

static int hda_init(void) {
    hda_detected = 0;
    hda_bar0 = 0;

    DbgPrint("hda: scanning PCI for HD Audio controllers\n");

    for (uint16_t bus = 0; bus < 256; bus++) {
        for (uint8_t slot = 0; slot < 32; slot++) {
            uint32_t id = pci_cfg_read((uint8_t)bus, slot, 0, 0x00);
            if ((id & 0xFFFF) == 0xFFFF)
                continue;

            uint32_t classreg = pci_cfg_read((uint8_t)bus, slot, 0, 0x08);
            uint8_t class_code = (uint8_t)(classreg >> 24);
            uint8_t subclass   = (uint8_t)(classreg >> 16);
            uint8_t prog_if    = (uint8_t)(classreg >> 8);

            if (class_code != 0x04 || subclass != 0x03)
                continue;

            uint8_t header = pci_cfg_read8((uint8_t)bus, slot, 0, 0x0E);
            uint8_t funcs = (header & 0x80) ? 8 : 1;

            for (uint8_t func = 0; func < funcs; func++) {
                id = pci_cfg_read((uint8_t)bus, slot, func, 0x00);
                if ((id & 0xFFFF) == 0xFFFF)
                    continue;

                classreg = pci_cfg_read((uint8_t)bus, slot, func, 0x08);
                class_code = (uint8_t)(classreg >> 24);
                subclass = (uint8_t)(classreg >> 16);
                prog_if = (uint8_t)(classreg >> 8);

                if (class_code != 0x04 || subclass != 0x03)
                    continue;

                uint16_t vendor = (uint16_t)id;
                uint16_t device = (uint16_t)(id >> 16);
                uint64_t bar = 0;

                uint32_t barlo = pci_cfg_read((uint8_t)bus, slot, func, 0x10);
                if (!(barlo & 1)) {
                    bar = barlo & ~0xFULL;
                    if ((barlo & 0x6) == 0x4) {
                        uint32_t barhi =
                            pci_cfg_read((uint8_t)bus, slot, func, 0x14);
                        bar |= (uint64_t)barhi << 32;
                    }
                }

                hda_bus = (uint8_t)bus;
                hda_slot = slot;
                hda_func = func;
                hda_bar0 = bar;
                hda_detected = 1;

                DbgPrint(
                    "hda: found %04x:%04x at %02x:%02x.%u "
                    "class=%02x/%02x prog-if=%02x BAR0=%p\n",
                    vendor, device, bus, slot, func,
                    class_code, subclass, prog_if, (void *)bar);

                /* Continue scanning so multiple controllers are visible. */
            }
        }
    }

    if (!hda_detected)
        DbgPrint("hda: no HD Audio PCI controller found\n");

    return hda_detected ? 0 : -1;
}
